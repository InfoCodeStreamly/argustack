# === Jira (required) ===
JIRA_URL=https://your-instance.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token

# Projects to pull (comma-separated)
JIRA_PROJECTS=PROJ,ANOTHER

# === Jira Proxy (alternative to direct Jira API) ===
# JIRA_PROXY_TOKEN=your-service-token

# === PostgreSQL (defaults — no need to change) ===
DB_HOST=localhost
DB_PORT=5434
DB_USER=argustack
DB_PASSWORD=argustack_local
DB_NAME=argustack

# === Code Intelligence (optional — needed only for `argustack code`) ===
# Set these after running `argustack code init` which bootstraps the shared
# hub at ~/.argustack/code/ (Neo4j + Qdrant on standard ports).
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=argustack_local
# QDRANT_URL=http://localhost:6333

# Code embedding provider: lmstudio (default, local) or voyage (cloud)
# CODE_EMBEDDING_PROVIDER=lmstudio
# LMSTUDIO_URL=http://localhost:1234
# EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
# EMBEDDING_DIMS=1024
# RERANK_MODEL=                              # optional, LM Studio chat model id (e.g. Qwen3-Reranker)
# VOYAGE_API_KEY=                            # only if CODE_EMBEDDING_PROVIDER=voyage
