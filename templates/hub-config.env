# Argustack hub — global configuration shared by ALL workspaces.
#
# Location: ~/.argustack/config.env
# Loaded by every CLI invocation and MCP server start-up.
# Per-workspace settings (Jira project keys, git repo paths, etc.) live in
# the `workspaces.settings` JSONB column in the hub Postgres, not here.
#
# Permissions: chmod 600 recommended (this file may contain tokens).

# ===== Hub Postgres (created by `argustack init`) =====
DB_HOST=localhost
DB_PORT=15432
DB_NAME=argustack_hub
DB_USER=argustack
DB_PASSWORD=argustack_hub

# ===== Neo4j (code-intel graph) =====
NEO4J_URI=bolt://localhost:15435
NEO4J_USER=neo4j
NEO4J_PASSWORD=argustack_local

# ===== Qdrant (code-intel vectors) =====
QDRANT_URL=http://localhost:15436

# ===== Code embedding provider =====
# Managed by `argustack init`. Examples:
#
# Ollama (default after init):
#   CODE_EMBEDDING_PROVIDER=ollama
#   OLLAMA_URL=http://localhost:11434
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMS=768
#
# LM Studio:
#   CODE_EMBEDDING_PROVIDER=lmstudio
#   LMSTUDIO_URL=http://localhost:1234
#   EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
#   EMBEDDING_DIMS=1024
#
# Custom OpenAI-compatible server:
#   CODE_EMBEDDING_PROVIDER=custom
#   CUSTOM_EMBEDDING_URL=http://your-server:8080
#   EMBEDDING_MODEL=your-model-name
#   EMBEDDING_DIMS=768
#
# Voyage AI (cloud, paid):
#   CODE_EMBEDDING_PROVIDER=voyage
#   VOYAGE_API_KEY=pa-...
#   EMBEDDING_MODEL=voyage-code-3
#   EMBEDDING_DIMS=1024

# ===== Issue embeddings (OpenAI text-embedding-3-small, 1536d) =====
# Used by `argustack embed` for semantic search of Jira issues.
# OPENAI_API_KEY=

# ===== Jira credentials (one set per machine) =====
# Per-workspace project keys live in `workspaces.settings.jiraProjectKeys`.
# JIRA_URL=https://your-instance.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROXY_TOKEN=

# ===== GitHub credentials (one PAT per machine) =====
# Per-workspace `owner/repo` targets live in `workspaces.settings.githubRepos`.
# GITHUB_TOKEN=
